{
    "name": "mollu",
    "version": "1.2.0",
    "description": "BetterDiscord plugin that translates messages in chosen Discord servers into the language you pick",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build.mjs",
        "deploy": "node scripts/build.mjs --install",
        "watch": "node scripts/build.mjs --watch --install",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pretest": "npm run build",
        "test": "node scripts/smoke.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.1",
        "globals": "^17.11.0",
        "prettier": "^3.9.6"
    },
    "license": "MIT"
}
